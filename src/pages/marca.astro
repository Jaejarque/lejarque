    padding-bottom: 40px;
  }

  .brand-top-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
  }

  .brand-guide-tag {
    font-size: 11px;
    color: var(--accent-ink);
    letter-spacing: 0.1em;
  }

  .brand-page-title {
    font-size: var(--text-3xl);
    line-height: 1.15;
    margin-bottom: 18px;
    max-width: 24ch;
  }

  .brand-page-desc {
    font-size: var(--text-lg);
    color: var(--text-mute);
    line-height: 1.6;
    max-width: 65ch;
  }

  .brand-section {
    padding: 64px 0;
    border-top: 1px solid var(--line);
  }

  .section-title {
    font-size: clamp(22px, 2.6vw, 32px);
    font-weight: 500;
    color: var(--text);
    margin-bottom: 16px;
  }

  .brand-cols {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: start;
  }

  @media (min-width: 840px) {
    .brand-cols {
      grid-template-columns: 1fr 1fr;
      gap: 56px;
    }
  }

  .col-text p {
    font-size: 15px;
    color: var(--text-soft);
    line-height: 1.6;
    margin-bottom: 16px;
  }

  .spec-rules {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 20px;
    border-top: 1px solid var(--line);
    padding-top: 16px;
  }

  .spec-rules li {
    font-size: 13.5px;
    color: var(--text-mute);
    line-height: 1.5;
  }

  .spec-rules strong {
    color: var(--text);
  }

  .stage-blueprint {
    padding: 32px;
    display: grid;
    place-items: center;
    background-color: var(--panel);
  }

  .caption {
    font-size: 11.5px;
    color: var(--text-mute);
    margin-top: 12px;
    display: block;
  }

  /* Versiones */
  .versions-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    margin-top: 32px;
  }

  @media (min-width: 680px) {
    .versions-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .v-stage {
    padding: 36px 20px;
    display: grid;
    place-items: center;
    border-radius: var(--radius-xs);
  }

  /* Paleta */
  .swatches-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-top: 28px;
  }

  @media (min-width: 768px) {
