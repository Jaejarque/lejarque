---
import Layout from "../layouts/Layout.astro";
import Logo from "../components/Logo.astro";
import Isotype from "../components/Isotype.astro";
import siteConfig from "../config/site.config";
---

<Layout
  title={`Guía de Identidad Visual y UI Kit · ${siteConfig.brand.name} ${siteConfig.brand.descriptor}`}
  description="Manual de identidad corporativa, sistema de diseño suizo, paleta cobre técnico, maquetas vectoriales y kit de interfaz."
>
  <div class="brand-system-page">
    <div class="container">
      <!-- Encabezado de la Guía de Marca -->
      <header class="brand-header">
        <div class="brand-top-nav">
          <span class="mono brand-guide-tag">MANUAL DE IDENTIDAD VISUAL · VERSIÓN B (COBRE TÉCNICO)</span>
          <button type="button" class="btn btn-outline btn-sm" id="brandThemeToggle">
            Alternar tema local
          </button>
        </div>

        <h1 class="brand-page-title">
          Sistema de diseño e identidad visual de ingeniería.
        </h1>
        <p class="brand-page-desc">
          {siteConfig.brand.name} {siteConfig.brand.descriptor} construye sistemas a medida y arquitectura de datos. 
          La marca lo dice con una sola estructura: líneas uniformes, nodos y una geometría que se puede medir con rigor arquitectónico.
        </p>
      </header>

      <!-- SECCIÓN 1: ISOTIPO Y CONSTRUCCIÓN -->
      <section class="brand-section" id="b-isotipo">
        <div class="brand-cols">
          <div class="col-text">
            <h2 class="section-title">01. Isotipo</h2>
            <p>
              Un hexágono isométrico contiene un segundo hexágono y un eje de tres ramas que converge en un nodo central. 
              Se lee como módulo, conexión y punto de decisión, sin recurrir a una L ni a una E.
            </p>
            <p>
              Todo el trazo mide 2 unidades en una rejilla de 64. No hay rellenos decorativos, degradados ni sombras. 
              Los tres nodos huecos señalan los puntos donde el sistema se abre al exterior.
            </p>
            <ul class="spec-rules">
              <li><strong>Contorno exterior:</strong> blanco en fondo oscuro (#121417), grafito en fondo claro (#FFFFFF).</li>
              <li><strong>Estructura interna y nodos:</strong> cobre técnico (#D98340 en oscuro, #B8621F en claro).</li>
              <li><strong>Simetría:</strong> especular sobre el eje vertical, giro de 120° en el núcleo.</li>
            </ul>
          </div>

          <div class="col-visual">
            <div class="panel stage-blueprint">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="100%" max-width="420" role="img" aria-label="Construcción geométrica del isotipo">
                <defs>
                  <pattern id="gPatt" width="4" height="4" patternUnits="userSpaceOnUse">
                    <path d="M4 0H0V4" fill="none" stroke="var(--line)" stroke-width="0.15" />
                  </pattern>
                </defs>
                <rect width="64" height="64" fill="var(--bg)" />
                <rect width="64" height="64" fill="url(#gPatt)" />
                <g fill="none" stroke="var(--accent)" stroke-width="0.2" stroke-dasharray="1 1" opacity="0.85">
                  <circle cx="32" cy="32" r="26" />
                  <circle cx="32" cy="32" r="13" />
                  <path d="M32 0V64M0 32H64M9.48 19L54.52 45M54.52 19L9.48 45" />
                </g>
                <g fill="none" stroke-width="2" stroke-linejoin="miter">
                  <polygon points="32,6 54.52,19 54.52,45 32,58 9.48,45 9.48,19" stroke="var(--logo-fg)" />
                  <polygon points="32,19 43.26,25.5 43.26,38.5 32,45 20.74,38.5 20.74,25.5" stroke="var(--accent)" />
                  <path d="M32 6V19M43.26 38.5L54.52 45M20.74 38.5L9.48 45" stroke="var(--accent)" />
                  <path d="M32 19V32M43.26 38.5L32 32L20.74 38.5" stroke="var(--accent)" />
                </g>
                <g fill="var(--bg)" stroke="var(--accent)" stroke-width="1.6">
                  <circle cx="32" cy="6" r="2.8" />
                  <circle cx="54.52" cy="45" r="2.8" />
                  <circle cx="9.48" cy="45" r="2.8" />
                </g>
                <circle cx="32" cy="32" r="2" fill="var(--accent)" />
              </svg>
            </div>
            <span class="caption mono">Construcción sobre rejilla de 64 × 64. Radio exterior 26, interior 13, centro en (32, 32).</span>
          </div>
        </div>
      </section>

      <!-- SECCIÓN 2: IMAGOTIPO Y VERSIONES CROMÁTICAS -->
      <section class="brand-section" id="b-versiones">
        <h2 class="section-title">02. Imagotipo y Versiones Aprobadas</h2>
        <p>
          El símbolo va a la izquierda del texto. El nombre se compone en Geist Medium (500) con tracking ligeramente cerrado; 
          «SOFTWARE» queda en mayúsculas con tracking abierto (0.5em) en el color de acento.
        </p>

        <div class="versions-grid">
          <!-- Versión 1: Sobre Grafito -->
          <div class="version-card">
            <div class="panel v-stage" style="background-color: #121417;">
              <img src="/brand/imagotipo-dark.svg" alt="Versión sobre grafito" width="280" />
            </div>
            <span class="caption mono">Sobre grafito #121417 (Modo Oscuro Oficial)</span>
          </div>

          <!-- Versión 2: Sobre Blanco -->
          <div class="version-card">
            <div class="panel v-stage" style="background-color: #FFFFFF;">
              <img src="/brand/imagotipo-light.svg" alt="Versión sobre blanco" width="280" />
            </div>
            <span class="caption mono">Sobre blanco puro #FFFFFF (Cobre oscuro #B8621F)</span>
          </div>

          <!-- Versión 3: Sobre Gris Neutro -->
          <div class="version-card">
            <div class="panel v-stage" style="background-color: #2A2E35;">
              <img src="/brand/imagotipo-dark.svg" alt="Versión sobre gris" width="280" />
            </div>
            <span class="caption mono">Sobre grafito medio #2A2E35</span>
          </div>

          <!-- Versión 4: Monocromo sobre Cobre -->
          <div class="version-card">
            <div class="panel v-stage" style="background-color: #B8621F;">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 300 80" width="280" role="img" aria-label="Monocromo blanco sobre cobre">
                <g transform="translate(8 8)">
                  <g fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linejoin="miter">
                    <polygon points="32,6 54.52,19 54.52,45 32,58 9.48,45 9.48,19" />
                    <polygon points="32,19 43.26,25.5 43.26,38.5 32,45 20.74,38.5 20.74,25.5" />
                    <path d="M32 6V19M43.26 38.5L54.52 45M20.74 38.5L9.48 45M32 19V32M43.26 38.5L32 32L20.74 38.5" />
                  </g>
                  <circle cx="32" cy="6" r="2.8" fill="#B8621F" stroke="#FFFFFF" stroke-width="1.6" />
                  <circle cx="54.52" cy="45" r="2.8" fill="#B8621F" stroke="#FFFFFF" stroke-width="1.6" />
                  <circle cx="9.48" cy="45" r="2.8" fill="#B8621F" stroke="#FFFFFF" stroke-width="1.6" />
                  <circle cx="32" cy="32" r="2" fill="#FFFFFF" />
                </g>
                <text x="92" y="45" font-family="Geist, Inter, sans-serif" font-size="34" font-weight="500" letter-spacing="-0.5" fill="#FFFFFF">L’Ejarque</text>
                <text x="93.5" y="64" font-family="Geist, Inter, sans-serif" font-size="10.5" font-weight="500" letter-spacing="5.4" fill="#FFFFFF">SOFTWARE</text>
              </svg>
            </div>
            <span class="caption mono">Monocromo blanco sobre cobre #B8621F</span>
          </div>
        </div>
      </section>

      <!-- SECCIÓN 3: ÁREA DE PROTECCIÓN Y TAMAÑOS MÍNIMOS -->
      <section class="brand-section" id="b-proteccion">
        <div class="brand-cols">
          <div class="col-text">
            <h2 class="section-title">03. Área de Protección y Tamaños Mínimos</h2>
            <p>
              La unidad modular <strong>X</strong> equivale a un cuarto de la altura del isotipo (16 px en la escala base). 
              Ningún elemento gráfico, borde o bloque de texto puede ingresar a este margen perimetral.
            </p>
            <ul class="spec-rules">
              <li><strong>Margen mínimo:</strong> X en los 4 costados del imagotipo.</li>
              <li><strong>Imagotipo completo:</strong> nunca menor de 120 px de ancho en pantallas.</li>
              <li><strong>Isotipo solo:</strong> utilizable desde 24 px. Por debajo de 24 px, usar el favicon de 3 ramas.</li>
              <li><strong>Descriptor «SOFTWARE»:</strong> si queda menor a 7 px de alto, retirarlo y mantener solo el wordmark.</li>
              <li><strong>Prohibiciones estrictas:</strong> no girar, no aplicar sombras realistas, no rellenar áreas huecas ni alterar el color cobre por gradientes.</li>
            </ul>
          </div>

          <div class="col-visual">
            <div class="panel stage-blueprint">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 332 112" width="100%" max-width="480" role="img" aria-label="Área de exclusión X">
                <rect width="332" height="112" fill="var(--bg)" />
                <rect x="8" y="8" width="316" height="96" fill="none" stroke="var(--accent)" stroke-width="0.8" stroke-dasharray="3 3" />
                <rect x="24" y="24" width="284" height="64" fill="none" stroke="var(--line)" stroke-width="0.8" />
                <g fill="var(--accent)" fill-opacity="0.18" stroke="var(--accent)" stroke-width="0.6">
                  <rect x="8" y="48" width="16" height="16" />
                  <rect x="308" y="48" width="16" height="16" />
                  <rect x="148" y="8" width="16" height="16" />
                  <rect x="148" y="88" width="16" height="16" />
                </g>
                <g fill="var(--accent)" font-family="var(--font-mono)" font-size="9" text-anchor="middle">
                  <text x="16" y="59">X</text><text x="316" y="59">X</text><text x="156" y="19.5">X</text><text x="156" y="99.5">X</text>
                </g>
                <g transform="translate(16 16)">
                  <g transform="translate(8 8)">
                    <g fill="none" stroke-width="2" stroke-linejoin="miter">
                      <polygon points="32,6 54.52,19 54.52,45 32,58 9.48,45 9.48,19" stroke="var(--logo-fg)" />
                      <polygon points="32,19 43.26,25.5 43.26,38.5 32,45 20.74,38.5 20.74,25.5" stroke="var(--accent)" />
                      <path d="M32 6V19M43.26 38.5L54.52 45M20.74 38.5L9.48 45M32 19V32M43.26 38.5L32 32L20.74 38.5" stroke="var(--accent)" />
                    </g>
                    <circle cx="32" cy="6" r="2.8" fill="var(--bg)" stroke="var(--accent)" stroke-width="1.6" />
                    <circle cx="54.52" cy="45" r="2.8" fill="var(--bg)" stroke="var(--accent)" stroke-width="1.6" />
                    <circle cx="9.48" cy="45" r="2.8" fill="var(--bg)" stroke="var(--accent)" stroke-width="1.6" />
                    <circle cx="32" cy="32" r="2" fill="var(--accent)" />
                  </g>
                  <text x="92" y="45" font-family="Geist, Inter, sans-serif" font-size="34" font-weight="500" letter-spacing="-0.5" fill="var(--logo-fg)">L’Ejarque</text>
                  <text x="93.5" y="64" font-family="Geist, Inter, sans-serif" font-size="10.5" font-weight="500" letter-spacing="5.4" fill="var(--accent)">SOFTWARE</text>
                </g>
              </svg>
            </div>
            <span class="caption mono">Módulos cobre indican X = 16px. Zona delimitada por trazo discontinuo.</span>
          </div>
        </div>
      </section>

      <!-- SECCIÓN 4: PALETA CROMÁTICA -->
      <section class="brand-section" id="b-color">
        <h2 class="section-title">04. Paleta Cromática y Contrastes WCAG</h2>
        <p>
          Dos neutros profundos, un blanco puro y un único acento. El cobre aparece solo donde hay estructura, conductor o énfasis técnico.
        </p>

        <div class="swatches-grid">
          <div class="swatch-box" style="background-color: #121417; color: #FFFFFF;">
            <span class="sw-name">Grafito técnico</span>
            <code class="mono">#121417</code>
            <span class="sw-desc">Fondo corporativo oscuro</span>
          </div>
          <div class="swatch-box" style="background-color: #2A2E35; color: #FFFFFF;">
            <span class="sw-name">Grafito medio</span>
            <code class="mono">#2A2E35</code>
            <span class="sw-desc">Líneas y paneles</span>
          </div>
          <div class="swatch-box" style="background-color: #E5E7EB; color: #121417;">
            <span class="sw-name">Gris claro</span>
            <code class="mono">#E5E7EB</code>
            <span class="sw-desc">Texto secundario / Borde claro</span>
          </div>
          <div class="swatch-box" style="background-color: #FFFFFF; color: #121417;">
            <span class="sw-name">Blanco puro</span>
            <code class="mono">#FFFFFF</code>
            <span class="sw-desc">Titulares en oscuro / Fondo claro</span>
          </div>
          <div class="swatch-box" style="background-color: #D98340; color: #121417;">
            <span class="sw-name">Cobre técnico</span>
            <code class="mono">#D98340</code>
            <span class="sw-desc">Acento en modo oscuro</span>
          </div>
          <div class="swatch-box" style="background-color: #B8621F; color: #FFFFFF;">
            <span class="sw-name">Cobre oscuro</span>
            <code class="mono">#B8621F</code>
            <span class="sw-desc">Acento en modo claro (AA)</span>
          </div>
        </div>

        <div class="color-ratio-bar" aria-hidden="true">
          <div style="width: 60%; background: #121417;"></div>
          <div style="width: 18%; background: #2A2E35;"></div>
          <div style="width: 12%; background: #FFFFFF;"></div>
          <div style="width: 10%; background: #D98340;"></div>
        </div>
        <span class="caption mono">Proporción recomendada: 60% Grafito, 18% Gris medio, 12% Blanco, 10% Acento Cobre.</span>
      </section>

      <!-- SECCIÓN 5: TIPOGRAFÍA -->
      <section class="brand-section" id="b-tipo">
        <h2 class="section-title">05. Tipografía</h2>
        <p>Familias de código abierto con licencia SIL OFL, diseñadas para interfaces y renderizado subpixel impecable.</p>

        <div class="typography-display panel">
          <div class="type-sample-big">L’Ejarque</div>
          <div class="type-sample-sub mono">SOFTWARE</div>
        </div>

        <dl class="type-specs-list">
          <div class="type-spec-row">
            <dt class="mono">Wordmark</dt>
            <dd>Geist Medium (500), tracking −1.5% a −2%, interlineado 1.15.</dd>
          </div>
          <div class="type-spec-row">
            <dt class="mono">Descriptor</dt>
            <dd>Geist Medium (500), mayúsculas, tracking +0.5em, tamaño 31% del wordmark.</dd>
          </div>
          <div class="type-spec-row">
            <dt class="mono">Titulares</dt>
            <dd>Geist 500 / Inter 500, escala fluida con clamp(), interlineado 1.1–1.15.</dd>
          </div>
          <div class="type-spec-row">
            <dt class="mono">Texto corrido</dt>
            <dd>Inter 400 / Geist 400, 16–18 px, interlineado 1.6, líneas de máximo 65 caracteres.</dd>
          </div>
          <div class="type-spec-row">
            <dt class="mono">Código y datos</dt>
            <dd>Geist Mono 400/500 para telemetría, métricas y bloques de código.</dd>
          </div>
        </dl>
      </section>

      <!-- SECCIÓN 6: LAS 9 APLICACIONES VECTORIALES DE MARCA -->
      <section class="brand-section" id="b-aplicaciones">
        <h2 class="section-title">06. Aplicaciones en Objetos Reales (Maquetas Planas)</h2>
        <p>
          Nueve aplicaciones de marca representadas mediante maquetas vectoriales en SVG estricto, 
          extraídas directamente de los lineamientos visuales oficiales para validar contraste y proporciones.
        </p>

        <div class="mockups-nine-grid">
          <!-- 1. Tarjetas -->
          <figure class="mockup-fig panel">
            <svg viewBox="0 0 400 300" class="mockup-svg" aria-label="Tarjetas de presentación">
              <rect width="400" height="300" fill="#E5E7EB" />
              <!-- Frente -->
              <rect x="22" y="30" width="230" height="131" rx="4" fill="#121417" />
              <g transform="translate(108 66) scale(0.9)">
                <g fill="none" stroke-width="2" stroke-linejoin="miter">
                  <polygon points="32,6 54.52,19 54.52,45 32,58 9.48,45 9.48,19" stroke="#FFFFFF" />
                  <polygon points="32,19 43.26,25.5 43.26,38.5 32,45 20.74,38.5 20.74,25.5" stroke="#D98340" />
                  <path d="M32 6V19M43.26 38.5L54.52 45M20.74 38.5L9.48 45M32 19V32M43.26 38.5L32 32L20.74 38.5" stroke="#D98340" />
                </g>
                <circle cx="32" cy="6" r="2.8" fill="#121417" stroke="#D98340" stroke-width="1.6" />
                <circle cx="54.52" cy="45" r="2.8" fill="#121417" stroke="#D98340" stroke-width="1.6" />
                <circle cx="9.48" cy="45" r="2.8" fill="#121417" stroke="#D98340" stroke-width="1.6" />
                <circle cx="32" cy="32" r="2" fill="#D98340" />
              </g>
              <!-- Dorso -->
              <rect x="150" y="118" width="230" height="131" rx="4" fill="#FFFFFF" stroke="#CBD0D6" stroke-width="0.8" />
              <g transform="translate(164 128) scale(0.42)">
                <text x="92" y="45" font-family="Geist, Inter, sans-serif" font-size="34" font-weight="500" fill="#121417">L’Ejarque</text>
                <text x="93.5" y="64" font-family="Geist, Inter, sans-serif" font-size="10.5" font-weight="500" letter-spacing="5.4" fill="#B8621F">SOFTWARE</text>
              </g>
              <text x="168" y="196" font-family="Geist, sans-serif" font-size="11" font-weight="500" fill="#121417">Nombre Apellido [EDITAR]</text>
              <text x="168" y="209" font-family="Geist, sans-serif" font-size="8" fill="#5B626D">Ingeniería de sistemas</text>
              <text x="168" y="226" font-family="Geist, sans-serif" font-size="8" fill="#121417">nombre@lejarque.com</text>
              <text x="168" y="237" font-family="Geist, sans-serif" font-size="8" fill="#121417">+54 11 5263-8890</text>
              <rect x="150" y="245" width="230" height="4" fill="#B8621F" />
            </svg>
            <figcaption>
              <h3 class="mockup-title">Tarjetas de presentación</h3>
              <p class="mockup-desc">Frente grafito con isotipo; dorso blanco con datos y banda cobre inferior.</p>
            </figcaption>
          </figure>

          <!-- 2. Hoja membretada -->
          <figure class="mockup-fig panel">
            <svg viewBox="0 0 400 300" class="mockup-svg" aria-label="Hoja membretada">
              <rect width="400" height="300" fill="#2A2E35" />
              <rect x="136" y="36" width="170" height="240" fill="#3A3F48" />
              <rect x="120" y="22" width="170" height="240" fill="#FFFFFF" />
              <text x="132" y="44" font-family="Geist, sans-serif" font-size="14" font-weight="500" fill="#121417">L’Ejarque</text>
              <text x="132" y="52" font-family="Geist, sans-serif" font-size="4.5" font-weight="500" letter-spacing="2.4" fill="#B8621F">SOFTWARE</text>
              <rect x="132" y="66" width="146" height="1" fill="#B8621F" />
              <rect x="132" y="92" width="146" height="3" rx="1.5" fill="#E5E7EB" />
              <rect x="132" y="101" width="140" height="3" rx="1.5" fill="#E5E7EB" />
              <rect x="132" y="110" width="146" height="3" rx="1.5" fill="#E5E7EB" />
              <rect x="132" y="119" width="120" height="3" rx="1.5" fill="#E5E7EB" />
              <rect x="132" y="238" width="146" height="0.8" fill="#BFC5CD" />
              <text x="132" y="250" font-family="var(--font-mono)" font-size="4.5" fill="#5B626D">LEJARQUE.COM · INGENIERÍA DE SISTEMAS</text>
            </svg>
            <figcaption>
              <h3 class="mockup-title">Hoja membretada</h3>
              <p class="mockup-desc">Formato A4 con cabecera sobria y pie de datos de contacto corporativo.</p>
            </figcaption>
          </figure>

          <!-- 3. Carpeta corporativa -->
          <figure class="mockup-fig panel">
            <svg viewBox="0 0 400 300" class="mockup-svg" aria-label="Carpeta corporativa">
              <rect width="400" height="300" fill="#E5E7EB" />
              <rect x="100" y="36" width="200" height="240" fill="#121417" />
              <rect x="118" y="36" width="1.5" height="240" fill="#2A2E35" />
              <g transform="translate(152 72) scale(1.5)">
                <polygon points="32,6 54.52,19 54.52,45 32,58 9.48,45 9.48,19" fill="none" stroke="#FFFFFF" stroke-width="2" />
                <polygon points="32,19 43.26,25.5 43.26,38.5 32,45 20.74,38.5 20.74,25.5" fill="none" stroke="#D98340" stroke-width="2" />
                <path d="M32 6V19M43.26 38.5L54.52 45M20.74 38.5L9.48 45M32 19V32M43.26 38.5L32 32L20.74 38.5" fill="none" stroke="#D98340" stroke-width="2" />
                <circle cx="32" cy="32" r="2" fill="#D98340" />
              </g>
              <text x="200" y="205" text-anchor="middle" font-family="Geist, sans-serif" font-size="20" font-weight="500" fill="#FFFFFF">L’Ejarque</text>
              <text x="202" y="222" text-anchor="middle" font-family="Geist, sans-serif" font-size="6.5" font-weight="500" letter-spacing="3.4" fill="#D98340">SOFTWARE</text>
            </svg>
            <figcaption>
              <h3 class="mockup-title">Carpeta corporativa</h3>
              <p class="mockup-desc">Cubierta grafito mate con isotipo de gran porte y lomo técnico.</p>
            </figcaption>
          </figure>

          <!-- 4. Bolsa de tela -->
          <figure class="mockup-fig panel">
            <svg viewBox="0 0 400 300" class="mockup-svg" aria-label="Bolsa de tela">
              <rect width="400" height="300" fill="#2A2E35" />
              <path d="M150,112 V78 C150,22 250,22 250,78 V112" fill="none" stroke="#F2F3F5" stroke-width="9" stroke-linecap="round" />
              <path d="M105,100 H295 L305,275 H95 Z" fill="#F2F3F5" />
              <g transform="translate(162 134) scale(1.2)">
