---
export interface Props {
  size?: number | string;
  class?: string;
  strokeWidth?: number;
  animated?: boolean;
}

const {
  size = 40,
  class: className = "",
  strokeWidth = 2,
  animated = false,
} = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 64 64"
  width={size}
  height={size}
  fill="none"
  stroke-width={strokeWidth}
  stroke-linejoin="miter"
  stroke-linecap="butt"
  class={`isotype-svg ${animated ? "is-animated" : ""} ${className}`}
  role="img"
  aria-label="Isotipo L'Ejarque Software"
>
  <!-- Hexágono exterior (Blanco en oscuro / Grafito en claro) -->
  <polygon
    class="iso-outer"
    points="32,6 54.52,19 54.52,45 32,58 9.48,45 9.48,19"
    stroke="var(--logo-fg)"
  />

  <!-- Hexágono interior (Cobre técnico) -->
  <polygon
    class="iso-inner"
    points="32,19 43.26,25.5 43.26,38.5 32,45 20.74,38.5 20.74,25.5"
    stroke="var(--accent)"
  />

  <!-- Eje de tres ramas y radios conectores -->
  <path
    class="iso-branches"
    d="M32 6V19M43.26 38.5L54.52 45M20.74 38.5L9.48 45"
    stroke="var(--accent)"
  />
  <path
    class="iso-core-branches"
    d="M32 19V32M43.26 38.5L32 32L20.74 38.5"
    stroke="var(--accent)"
  />

  <!-- Nodos exteriores huecos -->
  <g class="iso-nodes" fill="var(--bg)" stroke="var(--accent)" stroke-width="1.6">
    <circle class="iso-node node-top" cx="32" cy="6" r="2.8" />
    <circle class="iso-node node-right" cx="54.52" cy="45" r="2.8" />
    <circle class="iso-node node-left" cx="9.48" cy="45" r="2.8" />
  </g>

  <!-- Nodo central -->
  <circle class="iso-center" cx="32" cy="32" r="2" fill="var(--accent)" stroke="none" />
</svg>

<style>
  .isotype-svg {
    display: inline-block;
    vertical-align: middle;
    overflow: visible;
  }

  /* Animación de construcción técnica */
  .isotype-svg.is-animated polygon,
  .isotype-svg.is-animated path {
    stroke-dasharray: 180;
    stroke-dashoffset: 180;
    animation: constructStroke 1.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .isotype-svg.is-animated .iso-inner {
    animation-delay: 0.25s;
  }

  .isotype-svg.is-animated .iso-branches,
  .isotype-svg.is-animated .iso-core-branches {
    animation-delay: 0.45s;
  }

  .isotype-svg.is-animated .iso-nodes circle,
  .isotype-svg.is-animated .iso-center {
    opacity: 0;
    transform-origin: center;
    animation: popNode 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) 0.85s forwards;
  }

  @keyframes constructStroke {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes popNode {
    from {
      opacity: 0;
      transform: scale(0);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* Pulso microscópico en los nodos (micro-interacción) */
  @media (prefers-reduced-motion: no-preference) {
    .iso-node {
      animation: microPulse 6s ease-in-out infinite;
    }
    .node-right {
      animation-delay: 2s;
    }
    .node-left {
      animation-delay: 4s;
    }
  }

  @keyframes microPulse {
    0%, 100% {
      r: 2.8;
      stroke-width: 1.6;
    }
    50% {
      r: 3.2;
      stroke-width: 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .isotype-svg polygon,
    .isotype-svg path,
    .isotype-svg circle {
      animation: none !important;
      stroke-dashoffset: 0 !important;
      opacity: 1 !important;
    }
  }
</style>
