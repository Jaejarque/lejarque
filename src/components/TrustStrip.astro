---
import { translations } from "../config/i18n";

export interface Props {
  currentLang?: "es" | "en";
}

const { currentLang = "es" } = Astro.props;
const t = translations[currentLang];

const techList = [
  { name: "TypeScript", category: "Language" },
  { name: "Go / Golang", category: "Systems" },
  { name: "Python", category: "Data / AI" },
  { name: "Rust", category: "High Perf" },
  { name: "PostgreSQL", category: "ACID RDBMS" },
  { name: "ClickHouse", category: "OLAP Analytics" },
  { name: "DuckDB", category: "Embedded OLAP" },
  { name: "Apache Kafka", category: "Streaming" },
  { name: "Docker & K8s", category: "Containers" },
  { name: "Linux Systemd", category: "OS Core" },
  { name: "Terraform", category: "IaC" },
  { name: "ISO 27001 Aligned [EDITAR]", category: "Security" },
];
---

<section class="trust-strip" aria-label="Tecnologías y estándares">
  <div class="container">
    <div class="trust-head">
      <span class="trust-tag mono">{t.trust.heading}</span>
      <p class="trust-sub">{t.trust.subheading}</p>
    </div>

    <div class="tech-grid">
      {techList.map((item) => (
        <div class="tech-item">
          <div class="tech-meta">
            <span class="tech-cat mono">{item.category}</span>
          </div>
          <span class="tech-name mono">{item.name}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .trust-strip {
    padding-top: 48px;
    padding-bottom: 48px;
    background-color: var(--panel);
    border-bottom: 1px solid var(--line);
  }

  .trust-head {
    margin-bottom: 28px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .trust-tag {
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--accent-ink);
    font-weight: 500;
  }

  .trust-sub {
    font-size: 14px;
    color: var(--text-mute);
    max-width: 60ch;
  }

  .tech-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  @media (min-width: 640px) {
    .tech-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 980px) {
    .tech-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }

  .tech-item {
    border: 1px solid var(--line);
    background-color: var(--bg);
    padding: 12px 14px;
    border-radius: var(--radius-xs);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 8px;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }

  .tech-item:hover {
    border-color: var(--card-hover-border);
    background-color: var(--surface-active);
  }

  .tech-cat {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-mute);
  }

  .tech-name {
    font-size: 13.5px;
    font-weight: 500;
    color: var(--text);
  }
</style>
