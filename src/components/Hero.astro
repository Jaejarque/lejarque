---
import { translations } from "../config/i18n";
import siteConfig from "../config/site.config";

export interface Props {
  currentLang?: "es" | "en";
}

const { currentLang = "es" } = Astro.props;
const t = translations[currentLang];
---

<section class="hero-section" id="hero" aria-labelledby="heroTitle">
  <div class="container hero-container">
    <div class="hero-content">
      <div class="section-tag" aria-label="Descriptor técnico">
        <span>{t.hero.tag}</span>
      </div>

      <h1 id="heroTitle" class="hero-title">
        {t.hero.title}
      </h1>

      <p class="hero-subtitle">
        {t.hero.subtitle}
      </p>

      <div class="hero-actions">
        <a href="#cotizador" class="btn btn-primary hero-btn-main">
          <span>{t.hero.quoteBtn}</span>
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8H13M13 8L8.5 3.5M13 8L8.5 12.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" />
          </svg>
        </a>
        <a href="#proyectos" class="btn btn-outline hero-btn-sec">
          <span>{t.hero.projectsBtn}</span>
        </a>
      </div>

      <!-- Métricas arquitectónicas de rigor -->
      <div class="hero-metrics">
        <div class="metric-item">
          <span class="metric-val mono">{t.hero.specs.uptime}</span>
          <span class="metric-lbl">{t.hero.specs.uptimeLabel}</span>
        </div>
        <div class="metric-divider" aria-hidden="true"></div>
        <div class="metric-item">
          <span class="metric-val mono">{t.hero.specs.latency}</span>
          <span class="metric-lbl">{t.hero.specs.latencyLabel}</span>
        </div>
        <div class="metric-divider" aria-hidden="true"></div>
        <div class="metric-item">
          <span class="metric-val mono">{t.hero.specs.codeOwnership}</span>
          <span class="metric-lbl">{t.hero.specs.codeOwnershipLabel}</span>
        </div>
      </div>
    </div>

    <!-- Escenario visual: Isotipo ampliado como estructura isométrica -->
    <div class="hero-visual" id="heroVisualStage" aria-label="Estructura isométrica del isotipo">
      <div class="stage-frame">
        <div class="stage-grid"></div>
        
        <svg
          id="heroIsoSvg"
          viewBox="0 0 340 340"
          class="hero-iso-svg"
          role="img"
          aria-label="Diagrama isométrico interactivo"
        >
          <!-- Guías y cotas de arquitectura de fondo -->
          <g class="blueprint-guides" stroke="var(--line)" stroke-width="0.8" stroke-dasharray="2 3">
            <circle cx="170" cy="170" r="140" fill="none" />
            <circle cx="170" cy="170" r="70" fill="none" />
            <line x1="170" y1="20" x2="170" y2="320" />
            <line x1="30" y1="170" x2="310" y2="170" />
            <line x1="48" y1="99" x2="292" y2="241" />
            <line x1="292" y1="99" x2="48" y2="241" />
          </g>

          <!-- Isotipo ampliado transformado a escala 340x340 (centro 170, 170) -->
          <!-- Multiplicador x4.375 sobre coordenadas base de 64x64 -->
          <g id="isoTransformGroup">
            <!-- Hexágono exterior -->
            <polygon
              class="hero-poly-outer"
              points="170,30 291,100 291,240 170,310 49,240 49,100"
              stroke="var(--logo-fg)"
              stroke-width="3"
              fill="none"
              stroke-linejoin="miter"
            />

            <!-- Hexágono interior -->
            <polygon
              class="hero-poly-inner"
              points="170,100 231,135 231,205 170,240 109,205 109,135"
              stroke="var(--accent)"
              stroke-width="3"
              fill="none"
              stroke-linejoin="miter"
            />

            <!-- Ejes y ramas conectoras -->
            <path
              class="hero-path-branches"
              d="M170,30 V100 M231,205 L291,240 M109,205 L49,240"
              stroke="var(--accent)"
              stroke-width="3"
              fill="none"
            />
            <path
              class="hero-path-core"
              d="M170,100 V170 M231,205 L170,170 M109,205 L170,170"
              stroke="var(--accent)"
              stroke-width="3"
              fill="none"
            />

            <!-- Nodos exteriores reactivos al cursor -->
            <g class="hero-nodes-group">
              <g class="hero-node-item" id="nodeTop" transform="translate(170, 30)">
                <circle r="8" fill="var(--bg)" stroke="var(--accent)" stroke-width="2.5" />
                <circle r="2.5" fill="var(--accent)" />
              </g>
              <g class="hero-node-item" id="nodeRight" transform="translate(291, 240)">
                <circle r="8" fill="var(--bg)" stroke="var(--accent)" stroke-width="2.5" />
                <circle r="2.5" fill="var(--accent)" />
              </g>
              <g class="hero-node-item" id="nodeLeft" transform="translate(49, 240)">
                <circle r="8" fill="var(--bg)" stroke="var(--accent)" stroke-width="2.5" />
                <circle r="2.5" fill="var(--accent)" />
              </g>
              <!-- Nodo central de decisión -->
              <g class="hero-node-center" id="nodeCenter" transform="translate(170, 170)">
                <circle r="5" fill="var(--accent)" />
              </g>
            </g>
          </g>
        </svg>

        <!-- Etiqueta de cota técnica arquitectónica -->
        <div class="stage-tag mono" aria-hidden="true">
          <span>ISOTYPE_SCALE_1:1</span>
          <span class="coord">R26_R13_(32,32)</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding-top: clamp(48px, 6vw, 88px);
    padding-bottom: clamp(64px, 8vw, 104px);
    position: relative;
    border-bottom: 1px solid var(--line);
    background: radial-gradient(circle at 80% 20%, var(--surface-active) 0%, transparent 50%);
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    align-items: center;
  }

  @media (min-width: 980px) {
    .hero-container {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: 64px;
    }
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-title {
    font-size: var(--text-4xl);
    line-height: 1.08;
    margin-bottom: 20px;
    max-width: 20ch;
    font-weight: 500;
    color: var(--text);
  }

  .hero-subtitle {
    font-size: var(--text-md);
    color: var(--text-mute);
    line-height: 1.6;
    margin-bottom: 36px;
    max-width: 58ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: 48px;
  }

  .hero-btn-main {
    padding: 12px 24px;
    font-size: 15px;
  }

  .hero-btn-sec {
    padding: 12px 24px;
    font-size: 15px;
  }

  /* Franja de métricas */
  .hero-metrics {
    display: flex;
    align-items: center;
    gap: 20px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    width: 100%;
    flex-wrap: wrap;
  }

  .metric-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .metric-val {
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--text);
  }

  .metric-lbl {
    font-size: 11.5px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-mute);
  }

  .metric-divider {
    width: 1px;
    height: 32px;
    background-color: var(--line);
  }

  /* Escenario del Isotipo */
  .hero-visual {
    width: 100%;
    max-width: 480px;
    margin: 0 auto;
  }

  .stage-frame {
    position: relative;
    border: 1px solid var(--line);
    background-color: var(--panel);
    aspect-ratio: 1 / 1;
    display: grid;
    place-items: center;
    overflow: hidden;
    border-radius: var(--radius-xs);
  }

  /* Retícula blueprint en el interior del marco */
  .stage-grid {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 34px 34px;
    opacity: 0.45;
  }

  .stage-grid::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, var(--panel) 30%, transparent 85%);
  }

  .hero-iso-svg {
    position: relative;
    z-index: 2;
    width: 82%;
    height: 82%;
  }

  .stage-tag {
    position: absolute;
    bottom: 12px;
    left: 14px;
    right: 14px;
    display: flex;
    justify-content: space-between;
    font-size: 10px;
    color: var(--text-mute);
    letter-spacing: 0.05em;
    z-index: 3;
    pointer-events: none;
  }

  /* Animación de construcción SVG */
  .hero-poly-outer,
  .hero-poly-inner,
  .hero-path-branches,
  .hero-path-core {
    stroke-dasharray: 850;
    stroke-dashoffset: 850;
    animation: drawIso 1.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .hero-poly-inner {
    animation-delay: 0.3s;
  }

  .hero-path-branches {
    animation-delay: 0.55s;
  }

  .hero-path-core {
    animation-delay: 0.75s;
  }

  .hero-node-item,
  .hero-node-center {
    opacity: 0;
    animation: appearNode 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) 1.1s forwards;
    transition: transform 0.15s ease-out;
  }

  @keyframes drawIso {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes appearNode {
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-poly-outer,
    .hero-poly-inner,
    .hero-path-branches,
    .hero-path-core {
      animation: none !important;
      stroke-dashoffset: 0 !important;
    }
    .hero-node-item,
    .hero-node-center {
      animation: none !important;
      opacity: 1 !important;
    }
  }
</style>

<script is:inline>
  (function () {
    // Parallax suave sobre los nodos del isotipo al mover el cursor en el marco
    var stage = document.getElementById("heroVisualStage");
    var nTop = document.getElementById("nodeTop");
    var nRight = document.getElementById("nodeRight");
    var nLeft = document.getElementById("nodeLeft");
    var nCenter = document.getElementById("nodeCenter");

    if (!stage || window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      return;
    }

    stage.addEventListener("mousemove", function (e) {
      var rect = stage.getBoundingClientRect();
      var x = (e.clientX - rect.left) / rect.width - 0.5; // -0.5 a 0.5
      var y = (e.clientY - rect.top) / rect.height - 0.5;

      var dx = x * 10;
      var dy = y * 10;

      if (nTop) nTop.setAttribute("transform", "translate(" + (170 + dx * 0.8) + ", " + (30 + dy * 0.8) + ")");
      if (nRight) nRight.setAttribute("transform", "translate(" + (291 + dx * 1.2) + ", " + (240 + dy * 1.2) + ")");
      if (nLeft) nLeft.setAttribute("transform", "translate(" + (49 + dx * 0.9) + ", " + (240 + dy * 0.9) + ")");
      if (nCenter) nCenter.setAttribute("transform", "translate(" + (170 + dx * 0.5) + ", " + (170 + dy * 0.5) + ")");
    });

    stage.addEventListener("mouseleave", function () {
      if (nTop) nTop.setAttribute("transform", "translate(170, 30)");
      if (nRight) nRight.setAttribute("transform", "translate(291, 240)");
      if (nLeft) nLeft.setAttribute("transform", "translate(49, 240)");
      if (nCenter) nCenter.setAttribute("transform", "translate(170, 170)");
    });
  })();
</script>
