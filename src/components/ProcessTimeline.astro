---
import processData from "../content/process.json";
import { translations } from "../config/i18n";

export interface Props {
  currentLang?: "es" | "en";
}

const { currentLang = "es" } = Astro.props;
const t = translations[currentLang];
---

<section class="section-padding process-section" id="proceso" aria-labelledby="processTitle">
  <div class="container">
    <div class="section-head">
      <div class="section-tag">
        <span>{t.process.tag}</span>
      </div>
      <h2 id="processTitle">{t.process.title}</h2>
      <p>{t.process.subtitle}</p>
    </div>

    <!-- Línea de tiempo arquitectónica -->
    <div class="timeline-container">
      <div class="timeline-track" aria-hidden="true"></div>

      <div class="timeline-steps">
        {processData.map((stage) => (
          <div class="timeline-step-item">
            <div class="step-marker-col">
              <div class="step-node-circle">
                <span class="step-num mono">{stage.step}</span>
              </div>
            </div>

            <div class="step-content-card panel">
              <div class="step-head">
                <h3 class="step-name">{stage.name}</h3>
                <span class="step-timeline-badge mono">{stage.timeline}</span>
              </div>

              <p class="step-summary">{stage.summary}</p>

              <div class="step-deliverables-box">
                <span class="deliverables-title mono">{t.process.deliverablesLabel}</span>
                <ul class="deliverables-sublist">
                  {stage.deliverables.map((item) => (
                    <li>
                      <span class="bullet" aria-hidden="true">■</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .process-section {
    background-color: var(--panel);
  }

  .timeline-container {
    position: relative;
    padding-left: 20px;
  }

  @media (min-width: 768px) {
    .timeline-container {
      padding-left: 0;
    }
  }

  .timeline-track {
    position: absolute;
    left: 44px;
    top: 24px;
    bottom: 24px;
    width: 2px;
    background-color: var(--line);
    display: none;
  }

  @media (min-width: 768px) {
    .timeline-track {
      display: block;
    }
  }

  .timeline-steps {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .timeline-step-item {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    position: relative;
  }

  @media (min-width: 768px) {
    .timeline-step-item {
      grid-template-columns: 88px 1fr;
      gap: 24px;
      align-items: start;
    }
  }

  .step-marker-col {
    display: flex;
    justify-content: flex-start;
  }

  @media (min-width: 768px) {
    .step-marker-col {
      justify-content: center;
      position: sticky;
      top: 100px;
    }
  }

  .step-node-circle {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-xs);
    border: 2px solid var(--accent);
    background-color: var(--bg);
    display: grid;
    place-items: center;
    box-shadow: 0 0 0 4px var(--panel);
  }

  .step-num {
    font-size: 14px;
    font-weight: 500;
    color: var(--accent);
  }

  .step-content-card {
    background-color: var(--bg);
    border: 1px solid var(--line);
    padding: clamp(20px, 3.5vw, 32px);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .step-head {
    display: flex;
    flex-direction: column;
    gap: 8px;
    border-bottom: 1px solid var(--line);
    padding-bottom: 14px;
  }

  @media (min-width: 600px) {
    .step-head {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .step-name {
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--text);
  }

  .step-timeline-badge {
    font-size: 11.5px;
    color: var(--accent-ink);
    background-color: var(--surface-active);
    border: 1px solid var(--line);
    padding: 3px 10px;
    border-radius: var(--radius-xs);
    white-space: nowrap;
    align-self: flex-start;
  }

  .step-summary {
    font-size: 14.5px;
    color: var(--text-soft);
    line-height: 1.6;
  }

  .step-deliverables-box {
    background-color: var(--panel);
    border: 1px solid var(--line);
    padding: 16px 20px;
    border-radius: var(--radius-xs);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .deliverables-title {
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent-ink);
    font-weight: 500;
  }

  .deliverables-sublist {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .deliverables-sublist li {
    font-size: 13px;
    color: var(--text);
    display: flex;
    align-items: flex-start;
    gap: 8px;
    line-height: 1.45;
  }

  .bullet {
    color: var(--accent);
    font-size: 7px;
    margin-top: 5px;
    flex-shrink: 0;
  }
</style>
