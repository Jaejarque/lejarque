---
import projectsData from "../content/projects.json";
import { translations } from "../config/i18n";

export interface Props {
  currentLang?: "es" | "en";
}

const { currentLang = "es" } = Astro.props;
const t = translations[currentLang];

const categories = [
  { id: "all", name: t.projects.allFilter },
  { id: "sistemas-distribuidos", name: "Sistemas Distribuidos" },
  { id: "software-medida", name: "Software a Medida" },
  { id: "datos-bi", name: "Datos & Lakehouse" },
  { id: "modernizacion", name: "Modernización" },
  { id: "automatizacion-ia", name: "IA & Automatización" },
];
---

<section class="section-padding projects-section" id="proyectos" aria-labelledby="projectsTitle">
  <div class="container">
    <div class="section-head">
      <div class="section-tag">
        <span>{t.projects.tag}</span>
      </div>
      <h2 id="projectsTitle">{t.projects.title}</h2>
      <p>{t.projects.subtitle}</p>
    </div>

    <!-- Barra de búsqueda y filtros -->
    <div class="projects-controls">
      <div class="search-wrap">
        <svg class="search-icon" viewBox="0 0 16 16" width="16" height="16" fill="none" aria-hidden="true">
          <circle cx="7" cy="7" r="5" stroke="currentColor" stroke-width="1.5" />
          <path d="M11 11L14.5 14.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" />
        </svg>
        <input
          type="search"
          id="projectSearchInput"
          placeholder={t.projects.searchPlaceholder}
          class="project-search-input"
          aria-label="Buscar proyectos"
        />
      </div>

      <!-- Filtros de categoría -->
      <div class="category-filters" role="tablist" aria-label="Filtrar por categoría">
        {categories.map((cat, idx) => (
          <button
            type="button"
            class={`cat-filter-btn ${idx === 0 ? "is-active" : ""}`}
            data-category={cat.id}
            role="tab"
            aria-selected={idx === 0 ? "true" : "false"}
          >
            {cat.name}
          </button>
        ))}
      </div>
    </div>

    <!-- Rejilla de proyectos -->
    <div class="projects-grid" id="projectsContainer">
      {projectsData.map((project, idx) => (
        <article
          class="project-card panel"
          data-category={project.category}
          data-industry={project.industry}
          data-title={project.title.toLowerCase()}
          data-tech={project.stack.join(" ").toLowerCase()}
        >
          <!-- Miniatura SVG Generativa Monolínea -->
          <div class="project-thumb-stage" aria-hidden="true">
            {idx === 0 && (
              <svg viewBox="0 0 320 180" class="generative-svg" fill="none" stroke="currentColor">
                <g stroke="var(--line)" stroke-width="0.75">
                  <line x1="20" y1="90" x2="300" y2="90" />
                  <line x1="160" y1="20" x2="160" y2="160" />
                  <rect x="40" y="30" width="240" height="120" stroke-dasharray="4 4" />
                </g>
                <path d="M40,90 Q100,20 160,90 T280,90" stroke="var(--accent)" stroke-width="2" />
                <g fill="var(--bg)" stroke="var(--accent)" stroke-width="1.8">
                  <circle cx="100" cy="55" r="4" />
                  <circle cx="160" cy="90" r="4" />
                  <circle cx="220" cy="125" r="4" />
                </g>
                <text x="28" y="160" fill="var(--text-mute)" font-size="9" font-family="var(--font-mono)">FREQ: 45kHz · DUCKDB</text>
              </svg>
            )}
            {idx === 1 && (
              <svg viewBox="0 0 320 180" class="generative-svg" fill="none" stroke="currentColor">
                <g stroke="var(--line)" stroke-width="0.75">
                  <circle cx="160" cy="90" r="60" stroke-dasharray="2 3" />
                  <line x1="50" y1="40" x2="270" y2="140" />
                  <line x1="50" y1="140" x2="270" y2="40" />
                </g>
                <polygon points="160,50 230,90 230,130 160,170 90,130 90,90" stroke="var(--accent)" stroke-width="1.6" />
                <path d="M90,90 L230,130 M90,130 L230,90" stroke="var(--logo-fg)" stroke-width="1.2" />
                <g fill="var(--accent)">
                  <circle cx="160" cy="50" r="3.5" /><circle cx="230" cy="90" r="3.5" /><circle cx="90" cy="130" r="3.5" />
                </g>
                <text x="28" y="160" fill="var(--text-mute)" font-size="9" font-family="var(--font-mono)">TX_TPS: 12k/s · gRPC</text>
              </svg>
            )}
            {idx === 2 && (
              <svg viewBox="0 0 320 180" class="generative-svg" fill="none" stroke="currentColor">
                <g stroke="var(--line)" stroke-width="0.8">
                  <rect x="40" y="30" width="240" height="30" />
                  <rect x="40" y="75" width="240" height="30" />
                  <rect x="40" y="120" width="240" height="30" />
                </g>
                <path d="M80,45 V75 M160,45 V120 M240,75 V120" stroke="var(--accent)" stroke-width="2" />
                <circle cx="160" cy="60" r="3" fill="var(--accent)" />
                <circle cx="160" cy="105" r="3" fill="var(--accent)" />
                <text x="28" y="165" fill="var(--text-mute)" font-size="9" font-family="var(--font-mono)">LAKEHOUSE: 4.2M Tn · dbt</text>
              </svg>
            )}
            {idx === 3 && (
              <svg viewBox="0 0 320 180" class="generative-svg" fill="none" stroke="currentColor">
                <rect x="50" y="25" width="220" height="130" stroke="var(--accent)" stroke-width="1.5" stroke-dasharray="3 3" />
                <g stroke="var(--line)" stroke-width="0.8">
                  <line x1="50" y1="90" x2="270" y2="90" />
                  <line x1="160" y1="25" x2="160" y2="155" />
                </g>
                <circle cx="160" cy="90" r="32" stroke="var(--logo-fg)" stroke-width="2" />
                <path d="M144,90 H176 M160,74 V106" stroke="var(--accent)" stroke-width="2" />
                <text x="28" y="165" fill="var(--accent)" font-size="9" font-family="var(--font-mono)">CONFIDENTIAL · STRANGLER FIG</text>
              </svg>
            )}
            {idx === 4 && (
              <svg viewBox="0 0 320 180" class="generative-svg" fill="none" stroke="currentColor">
                <path d="M30,130 L90,40 L160,110 L230,50 L290,130" stroke="var(--accent)" stroke-width="2" />
                <g stroke="var(--line)" stroke-width="0.8">
                  <line x1="30" y1="140" x2="290" y2="140" />
                  <line x1="90" y1="40" x2="90" y2="140" stroke-dasharray="2 2" />
                  <line x1="230" y1="50" x2="230" y2="140" stroke-dasharray="2 2" />
                </g>
                <g fill="var(--bg)" stroke="var(--accent)" stroke-width="2">
                  <circle cx="90" cy="40" r="4.5" />
                  <circle cx="160" cy="110" r="4.5" />
                  <circle cx="230" cy="50" r="4.5" />
                </g>
                <text x="28" y="165" fill="var(--text-mute)" font-size="9" font-family="var(--font-mono)">SCADA TELEMETRY: 142 SUBSTATIONS</text>
              </svg>
            )}
            {idx === 5 && (
              <svg viewBox="0 0 320 180" class="generative-svg" fill="none" stroke="currentColor">
                <g stroke="var(--line)" stroke-width="0.8">
                  <rect x="40" y="30" width="110" height="120" />
                  <rect x="170" y="30" width="110" height="120" />
                </g>
                <path d="M150,90 H170" stroke="var(--accent)" stroke-width="2" />
                <path d="M60,50 H130 M60,70 H110 M60,90 H120 M60,110 H90" stroke="var(--line-soft)" stroke-width="1.5" />
                <circle cx="160" cy="90" r="5" fill="var(--bg)" stroke="var(--accent)" stroke-width="2" />
                <rect x="190" y="50" width="70" height="30" stroke="var(--accent)" stroke-width="1.2" stroke-dasharray="2 2" />
                <text x="28" y="165" fill="var(--text-mute)" font-size="9" font-family="var(--font-mono)">ON-PREMISE AI · OCR & LLM</text>
              </svg>
            )}
          </div>

          <!-- Cabecera del proyecto -->
          <div class="project-card-header">
            <div class="card-tags">
              <span class="tag-ind mono">{project.industryLabel}</span>
              {project.confidential && (
                <span class="badge-nda mono">{t.projects.confidentialTag}</span>
              )}
            </div>
            <h3 class="project-title">
              <a href={`/proyectos/${project.slug}`}>
                {project.title}
              </a>
            </h3>
            <p class="project-summary">{project.summary}</p>
          </div>

          <!-- Métricas del proyecto -->
          <div class="project-metrics-grid">
            {project.metrics.slice(0, 2).map((m) => (
              <div class="m-box">
                <span class="m-val mono">{m.value}</span>
                <span class="m-lbl">{m.label}</span>
              </div>
            ))}
          </div>

          <!-- Stack de tecnologías -->
          <div class="project-stack-wrap">
            {project.stack.slice(0, 5).map((stk) => (
              <span class="tech-tag mono">{stk}</span>
            ))}
          </div>

          <!-- Enlace al estudio de caso -->
          <div class="project-footer">
            <a href={`/proyectos/${project.slug}`} class="link-case-study">
              <span>{t.projects.viewCaseStudy}</span>
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M3 7H11M11 7L7 3M11 7L7 11" stroke="currentColor" stroke-width="1.5" />
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .projects-section {
    background-color: var(--bg);
  }

  .projects-controls {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 36px;
  }

  @media (min-width: 860px) {
    .projects-controls {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .search-wrap {
    position: relative;
    max-width: 400px;
    width: 100%;
  }

  .search-icon {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-mute);
    pointer-events: none;
  }

  .project-search-input {
    width: 100%;
    background-color: var(--panel);
    border: 1px solid var(--line);
    color: var(--text);
    padding: 10px 14px 10px 38px;
    font-size: 13.5px;
    border-radius: var(--radius-xs);
    outline: none;
    transition: border-color 0.15s ease;
  }

  .project-search-input:focus {
    border-color: var(--accent);
  }

  .category-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .cat-filter-btn {
    background: transparent;
    border: 1px solid var(--line);
    color: var(--text-mute);
    padding: 6px 12px;
    font-size: 12.5px;
    border-radius: var(--radius-xs);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .cat-filter-btn:hover {
    color: var(--text);
    border-color: var(--line-soft);
  }

  .cat-filter-btn.is-active {
    background-color: var(--panel);
    border-color: var(--accent);
    color: var(--accent);
    font-weight: 500;
  }

  /* Rejilla de tarjetas */
  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
  }

  @media (min-width: 720px) {
    .projects-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1080px) {
    .projects-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .project-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 0;
    overflow: hidden;
    background-color: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius-xs);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .project-card:hover {
    border-color: var(--card-hover-border);
  }

  .project-thumb-stage {
    background-color: var(--bg);
    border-bottom: 1px solid var(--line);
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px;
    overflow: hidden;
  }

  .generative-svg {
    width: 100%;
    height: 100%;
  }

  .project-card-header {
    padding: 24px 24px 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .card-tags {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .tag-ind {
    font-size: 10.5px;
    color: var(--accent-ink);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .badge-nda {
    font-size: 10px;
    color: var(--accent);
    background-color: var(--surface-active);
    border: 1px dashed var(--accent);
    padding: 1px 6px;
    border-radius: var(--radius-xs);
  }

  .project-title {
    font-size: 1.15rem;
    font-weight: 500;
    line-height: 1.3;
    color: var(--text);
  }

  .project-title a:hover {
    color: var(--accent-hi);
  }

  .project-summary {
    font-size: 13.5px;
    color: var(--text-mute);
    line-height: 1.5;
  }

  .project-metrics-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    padding: 0 24px 16px;
  }

  .m-box {
    border: 1px solid var(--line);
    background-color: var(--bg);
    padding: 8px 10px;
    border-radius: var(--radius-xs);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .m-val {
    font-size: 15px;
    font-weight: 500;
    color: var(--accent);
  }

  .m-lbl {
    font-size: 10.5px;
    color: var(--text-mute);
    line-height: 1.25;
  }

  .project-stack-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 0 24px 16px;
  }

  .tech-tag {
    font-size: 11px;
    background-color: var(--bg);
    border: 1px solid var(--line);
    padding: 3px 6px;
    color: var(--text-soft);
    border-radius: var(--radius-xs);
  }

  .project-footer {
    padding: 16px 24px;
    border-top: 1px solid var(--line);
    background-color: var(--bg);
  }

  .link-case-study {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 500;
    color: var(--text);
    transition: color 0.15s ease, gap 0.15s ease;
  }

  .link-case-study:hover {
    color: var(--accent);
    gap: 12px;
  }
</style>

<script is:inline>
  (function () {
    var searchInput = document.getElementById("projectSearchInput");
    var filterBtns = document.querySelectorAll(".cat-filter-btn");
    var cards = document.querySelectorAll(".project-card");

    function applyFilters() {
      var query = (searchInput ? searchInput.value : "").trim().toLowerCase();
      var activeBtn = document.querySelector(".cat-filter-btn.is-active");
      var category = activeBtn ? activeBtn.getAttribute("data-category") : "all";

      cards.forEach(function (card) {
        var cardCat = card.getAttribute("data-category");
        var cardTitle = card.getAttribute("data-title") || "";
        var cardTech = card.getAttribute("data-tech") || "";

        var matchesCategory = category === "all" || cardCat === category;
        var matchesQuery = !query || cardTitle.includes(query) || cardTech.includes(query);

        if (matchesCategory && matchesQuery) {
          card.style.display = "flex";
        } else {
          card.style.display = "none";
        }
      });
    }

    if (searchInput) {
      searchInput.addEventListener("input", applyFilters);
    }

    filterBtns.forEach(function (btn) {
      btn.addEventListener("click", function () {
        filterBtns.forEach(function (b) {
          b.classList.remove("is-active");
          b.setAttribute("aria-selected", "false");
        });
        btn.classList.add("is-active");
        btn.setAttribute("aria-selected", "true");
        applyFilters();
      });
    });
  })();
</script>
