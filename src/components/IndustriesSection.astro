---
import industriesData from "../content/industries.json";
import { translations } from "../config/i18n";

export interface Props {
  currentLang?: "es" | "en";
}

const { currentLang = "es" } = Astro.props;
const t = translations[currentLang];
---

<section class="section-padding industries-section" id="soluciones" aria-labelledby="industriesTitle">
  <div class="container">
    <div class="section-head">
      <div class="section-tag">
        <span>{t.solutions.tag}</span>
      </div>
      <h2 id="industriesTitle">{t.solutions.title}</h2>
      <p>{t.solutions.subtitle}</p>
    </div>

    <!-- Rejilla de soluciones por industria con problema, enfoque y módulos -->
    <div class="industries-grid">
      {industriesData.map((ind, idx) => (
        <article class="industry-card panel">
          <div class="card-header">
            <span class="ind-index mono">SECTOR_0{idx + 1}</span>
            <h3 class="ind-name">{ind.name}</h3>
          </div>

          <div class="card-section challenge-section">
            <span class="sub-label mono">{t.solutions.problemLabel}</span>
            <p class="challenge-text">{ind.problem}</p>
          </div>

          <div class="card-section solution-section">
            <span class="sub-label mono">{t.solutions.solutionLabel}</span>
            <p class="solution-text">{ind.solution}</p>
          </div>

          <div class="card-section modules-section">
            <span class="sub-label mono">{t.solutions.modulesLabel}</span>
            <ul class="modules-list">
              {ind.modules.map((mod) => (
                <li>
                  <span class="mod-bullet" aria-hidden="true">■</span>
                  <span>{mod}</span>
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .industries-section {
    background-color: var(--panel);
  }

  .industries-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  @media (min-width: 768px) {
    .industries-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .industries-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .industry-card {
    background-color: var(--bg);
    border: 1px solid var(--line);
    padding: 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 20px;
    transition: border-color 0.18s ease;
  }

  .industry-card:hover {
    border-color: var(--card-hover-border);
  }

  .card-header {
    border-bottom: 1px solid var(--line);
    padding-bottom: 16px;
  }

  .ind-index {
    font-size: 11px;
    color: var(--accent);
    letter-spacing: 0.1em;
    display: block;
    margin-bottom: 6px;
  }

  .ind-name {
    font-size: 1.2rem;
    color: var(--text);
    font-weight: 500;
    line-height: 1.25;
  }

  .card-section {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .sub-label {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-mute);
    font-weight: 500;
  }

  .challenge-text {
    font-size: 13.5px;
    color: var(--text-mute);
    line-height: 1.5;
  }

  .solution-text {
    font-size: 13.5px;
    color: var(--text-soft);
    line-height: 1.5;
  }

  .modules-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 4px;
  }

  .modules-list li {
    font-size: 12.5px;
    color: var(--text);
    display: flex;
    align-items: flex-start;
    gap: 8px;
    line-height: 1.4;
  }

  .mod-bullet {
    color: var(--accent);
    font-size: 7px;
    margin-top: 5px;
    flex-shrink: 0;
  }
</style>
