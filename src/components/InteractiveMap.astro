---
import siteConfig from "../config/site.config";

export interface Props {
  lat?: number;
  lng?: number;
}

const {
  lat = siteConfig.contact.address.coordinates.lat,
  lng = siteConfig.contact.address.coordinates.lng,
} = Astro.props;
---

<div class="interactive-map-wrapper panel" id="mapWrapper">
  <!-- Marcador de carga previa para privacidad y rendimiento (No carga scripts hasta interacción) -->
  <div class="map-placeholder" id="mapPlaceholder">
    <div class="placeholder-blueprint">
      <svg viewBox="0 0 100 100" width="48" height="48" fill="none" class="pin-iso-svg" aria-hidden="true">
        <polygon points="50,15 80,32 80,68 50,85 20,68 20,32" stroke="var(--logo-fg)" stroke-width="2" />
        <polygon points="50,32 66,41 66,59 50,68 34,59 34,41" stroke="var(--accent)" stroke-width="2" />
        <circle cx="50" cy="50" r="3" fill="var(--accent)" />
      </svg>
      <div class="placeholder-info">
        <span class="coord-label mono">COORD: {lat}, {lng}</span>
        <span class="address-text">{siteConfig.contact.address.street}, {siteConfig.contact.address.city}</span>
      </div>
      <button type="button" class="btn btn-outline btn-sm" id="loadMapBtn">
        <span>Cargar mapa interactivo (OpenStreetMap)</span>
      </button>
    </div>
  </div>

  <!-- Contenedor activo de Leaflet -->
  <div id="leafletMapContainer" class="leaflet-map-view" style="display: none;" role="region" aria-label="Mapa de ubicación"></div>

  <!-- Barra de acciones inferiores del mapa -->
  <div class="map-footer-bar">
    <div class="map-meta">
      <span class="tz-label mono">Zona horaria: {siteConfig.contact.timezone}</span>
      <span class="hours-label mono">Horario: {siteConfig.contact.hours}</span>
    </div>
    <a
      href={`https://www.google.com/maps/search/?api=1&query=${lat},${lng}`}
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn-subtle btn-sm directions-btn"
    >
      <span>Cómo llegar (Google Maps)</span>
      <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
        <path d="M2.5 9.5L9.5 2.5M9.5 2.5H4.5M9.5 2.5V7.5" stroke="currentColor" stroke-width="1.3" />
      </svg>
    </a>
  </div>
</div>

<style>
  .interactive-map-wrapper {
    background-color: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius-xs);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .map-placeholder {
    height: 320px;
    background-color: var(--panel);
    background-image: 
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 28px 28px;
    display: grid;
    place-items: center;
    padding: 24px;
    position: relative;
  }

  .placeholder-blueprint {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    text-align: center;
    background: var(--bg);
    border: 1px solid var(--line);
    padding: 24px 32px;
    border-radius: var(--radius-xs);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
  }

  .placeholder-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .coord-label {
    font-size: 11px;
    color: var(--accent);
    letter-spacing: 0.08em;
  }

  .address-text {
    font-size: 13px;
    color: var(--text-soft);
  }

  .leaflet-map-view {
    height: 320px;
    width: 100%;
    background-color: var(--bg);
  }

  .map-footer-bar {
    padding: 12px 18px;
    border-top: 1px solid var(--line);
    background-color: var(--panel);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  @media (min-width: 600px) {
    .map-footer-bar {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .map-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .tz-label,
  .hours-label {
    font-size: 11px;
    color: var(--text-mute);
  }

  .btn-sm {
    padding: 6px 12px;
    font-size: 12px;
    min-height: 32px;
  }
</style>

<script is:inline define:vars={{ lat, lng }}>
  (function () {
    var loadBtn = document.getElementById("loadMapBtn");
    var placeholder = document.getElementById("mapPlaceholder");
    var container = document.getElementById("leafletMapContainer");

    if (!loadBtn || !placeholder || !container) return;

    loadBtn.addEventListener("click", function () {
      loadBtn.disabled = true;
      loadBtn.textContent = "Cargando componentes OpenStreetMap...";

      // Cargar Leaflet CSS
      var link = document.createElement("link");
      link.rel = "stylesheet";
      link.href = "https://unpkg.com/leaflet@1.9.4/dist/leaflet.css";
      document.head.appendChild(link);

      // Cargar Leaflet JS
      var script = document.createElement("script");
      script.src = "https://unpkg.com/leaflet@1.9.4/dist/leaflet.js";
      script.onload = function () {
        placeholder.style.display = "none";
        container.style.display = "block";

        if (window.L) {
          var map = window.L.map(container, {
            center: [lat, lng],
            zoom: 15,
            scrollWheelZoom: false,
          });

          // CARTO Dark Matter / Positron según tema actual
          var isDark = document.documentElement.getAttribute("data-theme") !== "light";
          var tileUrl = isDark
            ? "https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png"
            : "https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png";

          window.L.tileLayer(tileUrl, {
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
            maxZoom: 19,
          }).addTo(map);

          // Marcador personalizado Isotipo
          var iconSvg = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="32" height="32">' +
            '<rect width="32" height="32" rx="6" fill="#121417"/>' +
            '<polygon points="16,4 26,10 26,22 16,28 6,22 6,10" fill="none" stroke="#FFFFFF" stroke-width="2"/>' +
            '<path d="M16 4V16M26 22L16 16L6 22" fill="none" stroke="#D98340" stroke-width="2"/>' +
          '</svg>';

          var customIcon = window.L.divIcon({
            html: iconSvg,
            className: "custom-leaflet-marker",
            iconSize: [32, 32],
            iconAnchor: [16, 16],
          });

          var marker = window.L.marker([lat, lng], { icon: customIcon }).addTo(map);
          marker.bindPopup("<b>L'Ejarque Software</b><br>Ingeniería de Sistemas").openPopup();
        }
      };
      document.body.appendChild(script);
    });
  })();
</script>
