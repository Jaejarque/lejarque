---
import servicesData from "../content/services.json";
import { translations } from "../config/i18n";

export interface Props {
  currentLang?: "es" | "en";
}

const { currentLang = "es" } = Astro.props;
const t = translations[currentLang];
---

<section class="section-padding services-section" id="servicios" aria-labelledby="servicesTitle">
  <div class="container">
    <div class="section-head">
      <div class="section-tag">
        <span>{t.services.tag}</span>
      </div>
      <h2 id="servicesTitle">{t.services.title}</h2>
      <p>{t.services.subtitle}</p>
    </div>

    <!-- Lista editorial con numeración y panel expandible -->
    <div class="services-editorial-list" role="region" aria-label="Lista de servicios de ingeniería">
      {servicesData.map((service, index) => (
        <article class="service-editorial-item" id={`service-item-${service.id}`}>
          <div class="service-summary-row">
            <span class="service-num mono">{service.number}</span>
            <div class="service-title-wrap">
              <h3 class="service-title">{service.title}</h3>
              <p class="service-desc">{service.shortDescription}</p>
            </div>
            <button
              type="button"
              class="service-expand-btn"
              aria-expanded="false"
              aria-controls={`service-panel-${service.id}`}
              id={`service-btn-${service.id}`}
              data-target={`service-panel-${service.id}`}
              aria-label={`Desplegar detalles de ${service.title}`}
            >
              <span class="btn-text">{t.services.expandBtn}</span>
              <svg class="chevron-icon" viewBox="0 0 16 16" width="16" height="16" fill="none" aria-hidden="true">
                <path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" />
              </svg>
            </button>
          </div>

          <!-- Panel expandible con entregables, tecnologías y casos -->
          <div
            class="service-expanded-panel"
            id={`service-panel-${service.id}`}
            role="region"
            aria-labelledby={`service-btn-${service.id}`}
            hidden
          >
            <div class="panel-content-grid">
              <!-- Entregables -->
              <div class="panel-col">
                <h4 class="col-heading mono">{t.services.deliverablesLabel}</h4>
                <ul class="deliverables-list">
                  {service.deliverables.map((deliv) => (
                    <li>
                      <span class="bullet" aria-hidden="true">■</span>
                      <span>{deliv}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Tecnologías -->
              <div class="panel-col">
                <h4 class="col-heading mono">{t.services.technologiesLabel}</h4>
                <div class="tech-tags-wrap">
                  {service.technologies.map((tech) => (
                    <span class="tech-pill mono">{tech}</span>
                  ))}
                </div>

                <div class="cta-wrap" style="margin-top: 28px;">
                  <a
                    href={`#cotizador?service=${service.id}`}
                    class="btn btn-outline btn-sm quote-service-link"
                    data-service-id={service.id}
                  >
                    <span>Cotizar este servicio</span>
                    <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                      <path d="M2.5 6H9.5M9.5 6L6.5 3M9.5 6L6.5 9" stroke="currentColor" stroke-width="1.4" />
                    </svg>
                  </a>
                </div>
              </div>

              <!-- Casos de uso -->
              <div class="panel-col">
                <h4 class="col-heading mono">{t.services.casesLabel}</h4>
                <ul class="cases-list">
                  {service.useCases.map((uc) => (
                    <li>
                      <span class="dash" aria-hidden="true">—</span>
                      <span>{uc}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .services-section {
    background-color: var(--bg);
  }

  .services-editorial-list {
    border-top: 1px solid var(--line);
  }

  .service-editorial-item {
    border-bottom: 1px solid var(--line);
    transition: background-color 0.15s ease;
  }

  .service-editorial-item:hover {
    background-color: var(--surface-active);
  }

  .service-summary-row {
    padding: clamp(20px, 3.5vw, 32px) 0;
    display: grid;
    grid-template-columns: 48px 1fr auto;
    gap: 20px;
    align-items: start;
  }

  @media (max-width: 720px) {
    .service-summary-row {
      grid-template-columns: 36px 1fr;
    }
    .service-expand-btn {
      grid-column: 2;
      justify-self: start;
      margin-top: 8px;
    }
  }

  .service-num {
    font-size: clamp(16px, 2vw, 20px);
    font-weight: 500;
    color: var(--accent);
    line-height: 1.2;
  }

  .service-title-wrap {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .service-title {
    font-size: clamp(18px, 2.2vw, 24px);
    font-weight: 500;
    color: var(--text);
    line-height: 1.25;
  }

  .service-desc {
    color: var(--text-mute);
    font-size: 15px;
    line-height: 1.55;
    max-width: 68ch;
  }

  .service-expand-btn {
    background: transparent;
    border: 1px solid var(--line);
    color: var(--text-soft);
    padding: 8px 14px;
    font-size: 12.5px;
    font-family: var(--font-sans);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border-radius: var(--radius-xs);
    cursor: pointer;
    transition: all 0.15s ease;
    white-space: nowrap;
    align-self: center;
  }

  .service-expand-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .chevron-icon {
    transition: transform 0.2s ease;
  }

  .service-expand-btn[aria-expanded="true"] .chevron-icon {
    transform: rotate(180deg);
  }

  .service-expand-btn[aria-expanded="true"] {
    border-color: var(--accent);
    background-color: var(--panel);
    color: var(--accent);
  }

  /* Panel expandible */
  .service-expanded-panel {
    background-color: var(--panel);
    border-top: 1px dashed var(--line);
    padding: clamp(24px, 4vw, 40px);
    margin-bottom: 24px;
    border-radius: var(--radius-xs);
    border: 1px solid var(--line);
  }

  .panel-content-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }

  @media (min-width: 860px) {
    .panel-content-grid {
      grid-template-columns: 1.3fr 1fr 1.1fr;
      gap: 40px;
    }
  }

  .col-heading {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent-ink);
    margin-bottom: 14px;
    font-weight: 500;
  }

  .deliverables-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .deliverables-list li {
    font-size: 13.5px;
    color: var(--text);
    display: flex;
    align-items: flex-start;
    gap: 10px;
    line-height: 1.45;
  }

  .bullet {
    color: var(--accent);
    font-size: 8px;
    margin-top: 4px;
    flex-shrink: 0;
  }

  .tech-tags-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tech-pill {
    background-color: var(--bg);
    border: 1px solid var(--line);
    color: var(--text-soft);
    font-size: 11.5px;
    padding: 4px 8px;
    border-radius: var(--radius-xs);
  }

  .cases-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .cases-list li {
    font-size: 13.5px;
    color: var(--text-soft);
    display: flex;
    align-items: flex-start;
    gap: 8px;
    line-height: 1.45;
  }

  .dash {
    color: var(--accent);
    font-weight: 500;
    flex-shrink: 0;
  }

  .btn-sm {
    padding: 6px 12px;
    font-size: 12px;
    min-height: 32px;
  }
</style>

<script is:inline>
  (function () {
    var buttons = document.querySelectorAll(".service-expand-btn");

    buttons.forEach(function (btn) {
      btn.addEventListener("click", function () {
        var targetId = btn.getAttribute("data-target");
        var panel = document.getElementById(targetId);
        if (!panel) return;

        var isExpanded = btn.getAttribute("aria-expanded") === "true";
        if (isExpanded) {
          panel.hidden = true;
          btn.setAttribute("aria-expanded", "false");
        } else {
          panel.hidden = false;
          btn.setAttribute("aria-expanded", "true");
        }
      });
    });

    // Enlace directo al cotizador con servicio precargado
    document.querySelectorAll(".quote-service-link").forEach(function (link) {
      link.addEventListener("click", function (e) {
        var serviceId = link.getAttribute("data-service-id");
        window.dispatchEvent(new CustomEvent("prefill-cotizador", { detail: { serviceId: serviceId } }));
      });
    });
  })();
</script>
