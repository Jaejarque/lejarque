    background-color: var(--bg);
    border: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
</style>

<script is:inline define:vars={{ pricingData, siteConfig }}>
  (function () {
    var form = document.getElementById("cotizadorForm");
    if (!form) return;

    var currentStep = 1;
    var maxStep = 6;
    var currentCurrency = "USD";
    var exchangeRate = siteConfig.pricingDefaults.usdToArsRate || 1350;

    // Elementos del Wizard
    var prevBtn = document.getElementById("wizardPrevBtn");
    var nextBtn = document.getElementById("wizardNextBtn");
    var submitBtn = document.getElementById("wizardSubmitBtn");
    var progressFill = document.getElementById("progressFill");
    var slider = document.getElementById("moduleCountSlider");
    var sliderDisplay = document.getElementById("moduleCountDisplay");

    // Elementos del Panel de Resultados
    var investmentRangeDisplay = document.getElementById("investmentRangeDisplay");
    var exchangeRateCaption = document.getElementById("exchangeRateCaption");
    var weeksRangeDisplay = document.getElementById("weeksRangeDisplay");
    var hoursDisplay = document.getElementById("hoursDisplay");
    var supportCostDisplay = document.getElementById("supportCostDisplay");
    var breakdownTableBody = document.getElementById("breakdownTableBody");

    // Moneda buttons
    var currBtns = document.querySelectorAll(".curr-btn");

    // ------------------------------------------------------------------------
    // CÁLCULO EN CLIENTE
    // ------------------------------------------------------------------------
    function getFormData() {
      var formData = new FormData(form);
      var projectTypes = formData.getAll("projectTypes");
      if (projectTypes.length === 0) projectTypes = ["custom-software"];

      var moduleCount = parseInt(formData.get("moduleCount") || "4", 10);
      var estimatedUsers = parseInt(formData.get("estimatedUsers") || "500", 10);
      var platform = formData.get("platform") || "web";
      var complexity = formData.get("complexity") || "intermediate";
      var extras = formData.getAll("extras");
      var timeline = formData.get("timeline") || "standard";
      var supportPlan = formData.get("supportPlan") || "basic";

      return {
        projectTypes: projectTypes,
        moduleCount: moduleCount,
        estimatedUsers: estimatedUsers,
        platform: platform,
        complexity: complexity,
        extras: extras,
        timeline: timeline,
        supportPlan: supportPlan,
        currency: currentCurrency,
        rate: exchangeRate,
      };
    }

    function calculate(data) {
      var rateUSD = pricingData.currencyDefaults.hourlyRateUSD;
      var rate = data.rate;
      var breakdown = [];

      var baseProjectHours = 0;
      data.projectTypes.forEach(function (typeKey) {
        var pType = pricingData.projectTypes[typeKey];
        if (pType) {
          var h = Math.round(pType.baseHours * pType.multiplier);
          baseProjectHours += h;
          breakdown.push({
            concept: "Base: " + pType.name,
            hours: h,
            costUSD: h * rateUSD,
          });
        }
      });

      if (data.projectTypes.length > 1) {
        var synergy = Math.round(baseProjectHours * 0.15);
        baseProjectHours -= synergy;
        breakdown.push({
          concept: "Sinergia técnica (-15%)",
          hours: -synergy,
          costUSD: -synergy * rateUSD,
        });
      }

      var modules = Math.max(1, data.moduleCount);
      var modHours = modules * pricingData.scope.baseHoursPerModule;
      breakdown.push({
        concept: "Módulos funcionales (" + modules + "u)",
        hours: modHours,
        costUSD: modHours * rateUSD,
      });

      var userMult = 1.0;
      for (var i = 0; i < pricingData.scope.userScaleFactors.length; i++) {
        if (data.estimatedUsers <= pricingData.scope.userScaleFactors[i].maxUsers) {
          userMult = pricingData.scope.userScaleFactors[i].multiplier;
          break;
        }
      }

      var platConfig = pricingData.platforms[data.platform] || pricingData.platforms.web;
      var compConfig = pricingData.complexityLevels[data.complexity] || pricingData.complexityLevels.intermediate;

      var coreHours = baseProjectHours + modHours;
      var scaledHours = Math.round(coreHours * userMult * platConfig.multiplier * compConfig.multiplier);
      var diffHours = scaledHours - coreHours;

      if (diffHours > 0) {
        breakdown.push({
          concept: "Factor escala (" + compConfig.name + ")",
          hours: diffHours,
          costUSD: diffHours * rateUSD,
        });
      }

      var extrasHours = 0;
      data.extras.forEach(function (extKey) {
        var ext = pricingData.extras[extKey];
        if (ext) {
          extrasHours += ext.hours;
          breakdown.push({
            concept: ext.name,
            hours: ext.hours,
            costUSD: ext.hours * rateUSD,
          });
        }
      });

      var totalHours = scaledHours + extrasHours;
      var tmlConfig = pricingData.timelines[data.timeline] || pricingData.timelines.standard;
      var tmlDiff = Math.round(totalHours * (tmlConfig.multiplier - 1.0));
      if (tmlDiff !== 0) {
        totalHours += tmlDiff;
        breakdown.push({
          concept: "Plazo: " + tmlConfig.name,
          hours: tmlDiff,
          costUSD: tmlDiff * rateUSD,
        });
      }

      var baseCostUSD = totalHours * rateUSD;
      var minCostUSD = Math.round(baseCostUSD * pricingData.estimationConfig.minRangeFactor);
      var maxCostUSD = Math.round(baseCostUSD * pricingData.estimationConfig.maxRangeFactor);

      var isArs = data.currency === "ARS";
      var minCost = isArs ? Math.round(minCostUSD * rate) : minCostUSD;
      var maxCost = isArs ? Math.round(maxCostUSD * rate) : maxCostUSD;

      var sprintHours = pricingData.estimationConfig.hoursPerSprintWeek;
      var baseWeeks = Math.max(2, Math.round((totalHours / sprintHours) * tmlConfig.weeksMultiplier));
      var minWeeks = Math.max(2, Math.round(baseWeeks * 0.85));
      var maxWeeks = Math.round(baseWeeks * 1.25);

      var supConfig = pricingData.supportPlans[data.supportPlan] || pricingData.supportPlans.none;
      var supMonthly = supConfig.monthlyCostUSD;
      var supMonthlyDisplay = isArs ? Math.round(supMonthly * rate) : supMonthly;

      return {
        totalHours: totalHours,
        minCost: minCost,
        maxCost: maxCost,
        minWeeks: minWeeks,
        maxWeeks: maxWeeks,
        supMonthly: supMonthlyDisplay,
        supName: supConfig.name,
        currency: data.currency,
        breakdown: breakdown,
      };
    }

    function formatNumber(num) {
      return new Intl.NumberFormat("es-AR").format(num);
    }

    function updateUI() {
      var data = getFormData();
      var res = calculate(data);

      var sym = res.currency === "ARS" ? "$" : "$";
      var suffix = res.currency === "ARS" ? " ARS" : " USD";

      investmentRangeDisplay.textContent = sym + formatNumber(res.minCost) + " – " + sym + formatNumber(res.maxCost) + suffix;
      exchangeRateCaption.textContent = res.currency === "ARS" 
        ? "Cotización referencial 1 USD = " + formatNumber(exchangeRate) + " ARS [EDITAR]"
        : "Tarifas técnicas basadas en $45 USD/h [EDITAR]";

      weeksRangeDisplay.textContent = res.minWeeks + " a " + res.maxWeeks + " semanas";
      hoursDisplay.textContent = res.totalHours + " hs";

      if (res.supMonthly > 0) {
        supportCostDisplay.textContent = sym + formatNumber(res.supMonthly) + suffix + "/mes";
      } else {
        supportCostDisplay.textContent = "Sin abono (Garantía 90d)";
      }

      // Render tabla breakdown
      var rowsHtml = "";
      res.breakdown.forEach(function (b) {
        var cost = res.currency === "ARS" ? Math.round(b.costUSD * exchangeRate) : b.costUSD;
        rowsHtml += "<tr>" +
          "<td>" + b.concept + "</td>" +
          "<td class='td-num'>" + (b.hours > 0 ? "+" : "") + b.hours + "h</td>" +
          "<td class='td-num'>" + sym + formatNumber(cost) + "</td>" +
        "</tr>";
      });
      breakdownTableBody.innerHTML = rowsHtml;

      // Actualizar enlace de WhatsApp precargado
      var waBtn = document.getElementById("btnOpenWhatsapp");
      if (waBtn) {
        var msg = "Hola L'Ejarque Software. He configurado una estimación técnica en su web:%0A" +
          "• Módulos: " + data.moduleCount + "%0A" +
          "• Complejidad: " + data.complexity + "%0A" +
          "• Inversión estimada: " + sym + formatNumber(res.minCost) + " a " + sym + formatNumber(res.maxCost) + suffix + "%0A" +
          "• Plazo: " + res.minWeeks + " a " + res.maxWeeks + " semanas.%0A" +
          "Deseo coordinar una llamada técnica para revisar especificaciones.";
        waBtn.href = "https://wa.me/" + siteConfig.contact.whatsapp + "?text=" + msg;
      }
    }

    // ------------------------------------------------------------------------
    // PASOS Y NAVEGACIÓN
    // ------------------------------------------------------------------------
    function showStep(step) {
      currentStep = step;
      document.querySelectorAll(".wizard-step").forEach(function (el) {
        el.classList.remove("is-active");
      });
      var activeEl = document.getElementById("step-" + step);
      if (activeEl) activeEl.classList.add("is-active");

      // Progreso
      var pct = ((step) / maxStep) * 100;
      progressFill.style.width = pct + "%";

      document.querySelectorAll("[data-step-indicator]").forEach(function (badge) {
        var num = parseInt(badge.getAttribute("data-step-indicator"), 10);
        badge.classList.remove("active", "completed");
        if (num === step) badge.classList.add("active");
        else if (num < step) badge.classList.add("completed");
      });

      // Botones
      prevBtn.disabled = step === 1;
      if (step === maxStep) {
        nextBtn.style.display = "none";
        submitBtn.style.display = "inline-flex";
      } else {
        nextBtn.style.display = "inline-flex";
        submitBtn.style.display = "none";
      }
    }

    nextBtn.addEventListener("click", function () {
      if (currentStep < maxStep) {
        showStep(currentStep + 1);
      }
    });

    prevBtn.addEventListener("click", function () {
      if (currentStep > 1) {
        showStep(currentStep - 1);
      }
    });

    slider.addEventListener("input", function () {
      sliderDisplay.textContent = slider.value + " módulos";
      updateUI();
    });

    form.addEventListener("change", updateUI);

    // Conmutador de Moneda
    currBtns.forEach(function (btn) {
      btn.addEventListener("click", function () {
        currBtns.forEach(function (b) { b.classList.remove("is-active"); });
        btn.classList.add("is-active");
        currentCurrency = btn.getAttribute("data-curr");
        updateUI();
      });
    });

    // ------------------------------------------------------------------------
    // ACCIONES: Copiar link, Descargar PDF, Agendar reunión
    // ------------------------------------------------------------------------
    var btnCopy = document.getElementById("btnCopyShareLink");
    var copyText = document.getElementById("copyLinkText");
    if (btnCopy) {
      btnCopy.addEventListener("click", function () {
        var data = getFormData();
        var encoded = encodeURIComponent(JSON.stringify(data));
        var shareUrl = window.location.origin + window.location.pathname + "#cotizador?config=" + encoded;
        navigator.clipboard.writeText(shareUrl).then(function () {
          copyText.textContent = "¡Enlace copiado!";
          setTimeout(function () { copyText.textContent = t.estimator.copyLink; }, 2000);
        });
      });
    }

    var btnPdf = document.getElementById("btnDownloadPdf");
    if (btnPdf) {
      btnPdf.addEventListener("click", function () {
        window.print();
      });
    }

    var btnMeet = document.getElementById("btnScheduleMeeting");
    var meetModal = document.getElementById("meetingModal");
    var closeMeet = document.getElementById("closeMeetingModal");
    if (btnMeet && meetModal && closeMeet) {
      btnMeet.addEventListener("click", function () { meetModal.hidden = false; });
      closeMeet.addEventListener("click", function () { meetModal.hidden = true; });
      meetModal.addEventListener("click", function (e) {
        if (e.target === meetModal) meetModal.hidden = true;
      });
    }

    // ------------------------------------------------------------------------
    // ENVÍO DE LEAD CON HONEYPOT Y VALIDACIÓN
    // ------------------------------------------------------------------------
    form.addEventListener("submit", function (e) {
      e.preventDefault();
      var hp = document.getElementById("hp_field");
      if (hp && hp.value !== "") {
        // Spam bot detectado silenciosamente
        return;
      }

      var feedback = document.getElementById("leadSubmitFeedback");
      var name = document.getElementById("leadName").value;
      var email = document.getElementById("leadEmail").value;

      if (!name || !email) {
        feedback.hidden = false;
        feedback.className = "submit-feedback error";
        feedback.textContent = "Por favor completa tu nombre y correo corporativo.";
        return;
      }

      feedback.hidden = false;
      feedback.className = "submit-feedback success";
      feedback.textContent = "Estimación enviada con éxito. Hemos registrado tu solicitud y te contactaremos en menos de 24 horas.";
      submitBtn.disabled = true;
    });

    // ------------------------------------------------------------------------
    // EVENTO EXTERNO PARA PRECONFIGURAR DESDE SERVICIOS O IA COPILOT
    // ------------------------------------------------------------------------
    window.addEventListener("prefill-cotizador", function (e) {
      var sId = e.detail && e.detail.serviceId;
      if (sId) {
        var input = form.querySelector('input[value="' + sId + '"]');
        if (input) {
          input.checked = true;
          updateUI();
          var cotSec = document.getElementById("cotizador");
          if (cotSec) cotSec.scrollIntoView({ behavior: "smooth" });
        }
      }
    });

    // Inicializar
    showStep(1);
    updateUI();
  })();
</script>
