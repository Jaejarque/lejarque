    gap: 4px;
  }

  .m-title {
    font-size: 10px;
    text-transform: uppercase;
    color: var(--text-mute);
  }

  .m-data {
    font-size: 14px;
    font-weight: 500;
    color: var(--text);
  }

  .support-plan-indicator {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 14px;
    background-color: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius-xs);
    font-size: 11.5px;
  }

  .sup-lbl {
    color: var(--text-mute);
  }

  .sup-val {
    color: var(--accent);
    font-weight: 500;
  }

  /* Desglose desplegable */
  .breakdown-drawer {
    border: 1px solid var(--line);
    background-color: var(--bg);
    border-radius: var(--radius-xs);
    overflow: hidden;
  }

  .breakdown-summary {
    padding: 10px 14px;
    font-size: 11px;
    color: var(--text-soft);
    cursor: pointer;
    user-select: none;
    background-color: var(--panel);
    border-bottom: 1px solid var(--line);
  }

  .breakdown-table-wrap {
    max-height: 220px;
    overflow-y: auto;
  }

  .breakdown-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 11px;
  }

  .breakdown-table th,
  .breakdown-table td {
    padding: 8px 12px;
    text-align: left;
    border-bottom: 1px solid var(--line);
  }

  .breakdown-table th {
    color: var(--text-mute);
    font-weight: 500;
    background-color: var(--bg);
  }

  .th-num {
    text-align: right;
  }

  .breakdown-table td.td-num {
    text-align: right;
    font-family: var(--font-mono);
  }

  /* Botones de acción */
  .estimation-actions-stack {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .disclaimer-text {
    font-size: 11px;
    color: var(--text-mute);
    line-height: 1.45;
  }

  /* Modal genérico */
  .modal-backdrop {
    position: fixed;
    inset: 0;
    background-color: var(--modal-backdrop);
    z-index: 2000;
    display: grid;
    place-items: center;
    padding: 20px;
  }

  .modal-box {
    width: 100%;
    max-width: 520px;
    background-color: var(--panel);
    border: 1px solid var(--line);
    padding: 28px;
    border-radius: var(--radius-xs);
  }

  .modal-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 18px;
    border-bottom: 1px solid var(--line);
    padding-bottom: 12px;
  }

  .modal-title {
    font-size: 1.2rem;
    font-weight: 500;
    color: var(--text);
  }

  .modal-close-btn {
    background: none;
    border: none;
    color: var(--text-mute);
    font-size: 16px;
    cursor: pointer;
  }

  .meeting-mock-card {
    margin-top: 16px;
